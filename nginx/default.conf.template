# ============================================================================
# nginx 站点配置（模板）
#
# 官方 nginx 镜像的 entrypoint 会对本文件做环境变量替换后输出到
# /etc/nginx/conf.d/default.conf。注意只会替换 ${VAR} 形式的变量，
# nginx 自身的 $uri、$host 等不受影响。
#
# 可用环境变量：
#   LWG_BACKEND_HOST  后端服务地址，默认 lwg-backend（compose 服务名）
# ============================================================================

server {
    listen       80;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # 访问日志交给容器标准输出，便于 docker logs / 日志采集
    access_log /dev/stdout;
    error_log  /dev/stderr warn;

    gzip on;
    gzip_min_length 1k;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # ---- 静态资源 ----
    # 带内容哈希的构建产物可长期缓存
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ---- 后端接口反向代理 ----
    # 前端代码里统一使用相对路径 /api（见 src/utils/request.js 的 baseURL），
    # 因此后端地址只在这里出现一次；容器内的 localhost 不是后端，必须用服务名。
    location /api/ {
        proxy_pass         http://${LWG_BACKEND_HOST}:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout    30s;
    }

    # 后端探活透传，便于运维直接在站点端口上检查后端状态
    location /actuator/health {
        proxy_pass       http://${LWG_BACKEND_HOST}:8080;
        proxy_set_header Host $host;
    }

    # ---- 单页应用路由回退 ----
    # vue-router 使用 history 模式，直接访问 /dashboard 这类路径时
    # 服务端并不存在对应文件，必须回退到 index.html 交给前端路由处理
    location / {
        try_files $uri $uri/ /index.html;
    }
}
